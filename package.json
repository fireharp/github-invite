{
  "name": "github-invite-broker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:config": "node scripts/build-wrangler-config.mjs",
    "dev": "pnpm build:config && wrangler dev -c wrangler.generated.jsonc",
    "deploy": "pnpm build:config && wrangler deploy -c wrangler.generated.jsonc",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.9",
    "wrangler": "^4.92.0"
  }
}
