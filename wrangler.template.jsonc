{
  "name": "github-invite-broker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "account_id": "<CLOUDFLARE_ACCOUNT_ID>",

  "routes": [
    { "pattern": "<WORKER_HOSTNAME>", "zone_name": "<CLOUDFLARE_ZONE_NAME>", "custom_domain": true }
  ],

  "kv_namespaces": [
    { "binding": "INVITE_KV", "id": "<INVITE_KV_NAMESPACE_ID>" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "INVITE_CLAIMS", "class_name": "InviteClaims" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["InviteClaims"] }
  ]
}
